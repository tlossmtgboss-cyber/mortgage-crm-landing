{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/builder-application",
      "destination": "https://tlossmtgboss-cyber.github.io/cmg-builder-portal/register.html"
    },
    {
      "source": "/builder-application/:path*",
      "destination": "https://tlossmtgboss-cyber.github.io/cmg-builder-portal/:path*"
    },
    {
      "source": "/token",
      "destination": "https://app.perenniaai.com/token"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.perenniaai.com/api/:path*"
    }
  ]
}
